+/* Patch 0032 (note 0023, H29): host-signalled KeSetEvent for a guest event
+ * object, used by the NV2A walk on each ring-drain edge (hardware raises the
+ * PM ring-free interrupt there; Sudeki's D3D8LTCG ring-free event 0x2E2F5C is
+ * its software equivalent, and its ring writer parks forever without the
+ * per-drain signal). Same guest-state update as bridge_KeSetEvent above; the
+ * shadow lookup is lock-guarded (patch 0027). Call only from host threads
+ * outside guest code, never as a bridge. */
+void xbox_host_signal_event(uint32_t guest_va)
+{
+    HANDLE h;
+
+    if (BRIDGE_MEM32(guest_va + 4) == 0)
+        BRIDGE_MEM32(guest_va + 4) = 1;
+    h = ke_shadow_lookup(guest_va);
+    if (h)
+        SetEvent(h);
+}
