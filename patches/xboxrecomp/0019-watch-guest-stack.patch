--- a/src/kernel/xbox_memory_layout.c
+++ b/src/kernel/xbox_memory_layout.c
@@ -2145,6 +2145,28 @@
     }
     if (reps)
         fprintf(stderr, "            (previous frame x%d more)\n", reps);
+#elif defined(__linux__) && defined(__x86_64__) && defined(REG_RIP)
+    /* Patch 0019 probe: x86-64 Linux walk. The build is -fomit-frame-pointer
+     * in places, so scan the guest-writer thread's host stack for values
+     * dladdr resolves into the executable, oldest-address first is NOT
+     * assumed: print every hit with its depth from RSP. Crude, but it names
+     * the functions a trapped store came from, which is what the probe asks. */
+    /* Host nearest-symbols are misleading in a -fomit-pointer build, and the
+     * guest's own stack holds the truth: values in the image's code range are
+     * the guest call chain (each is directly sub_%08X in the gen tree). */
+    extern uint32_t g_xbox_code_lo, g_xbox_code_hi;
+    (void)ucv;
+    if (g_esp && g_memory_offset) {
+        const uint32_t *sp = (const uint32_t *)((uintptr_t)g_memory_offset + g_esp);
+        int shown = 0;
+        for (int i = 0; i < 256 && shown < 12; i++) {
+            uint32_t v = sp[i];
+            if (v > g_xbox_code_lo && v < g_xbox_code_hi) {
+                fprintf(stderr, "         g[esp+%-4d] sub_%08X\n", i * 4, v);
+                shown++;
+            }
+        }
+    }
 #else
     (void)ucv;
     fprintf(stderr, "         (host stack not available on this host)\n");
