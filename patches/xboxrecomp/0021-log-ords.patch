 #define KERNEL_LOG_ON_HALF() (g_kernel_call_count <= kernel_log_budget() / 2)
 
+/* RECOMP_LOG_ORDS="44,98,109": never go quiet for these ordinals. The
+   budget model goes silent exactly where a late subsystem (the title's
+   own audio driver, say) starts asking questions, and the interesting
+   calls are rare while the boring ones bury the budget. */
+static int kernel_ord_logged(unsigned o)
+{
+    static int done, n;
+    static unsigned ords[32];
+    if (!done) {
+        const char *e = getenv("RECOMP_LOG_ORDS");
+        done = 1;
+        while (e && *e && n < 32) {
+            ords[n++] = (unsigned)strtoul(e, (char **)&e, 0);
+            while (*e == ',' || *e == ' ')
+                e++;
+        }
+    }
+    for (int i = 0; i < n; i++)
+        if (ords[i] == o)
+            return 1;
+    return 0;
+}
