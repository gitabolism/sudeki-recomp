+/* Patch 0024 probe: RECOMP_VSH_IO prints the first runs' attribute inputs
+ * and oPos, the one view that separates wrong vertex data from a wrong
+ * program on a title whose batches report no valid coordinates. */
+int nv2a_vsh_run(const float in[NV2A_VSH_INPUTS][4], Nv2aVshOutput *out)
+{
+    static int io = -1;
+    static unsigned n;
+    int r = nv2a_vsh_run_inner(in, out);
+
+    if (io < 0)
+        io = getenv("RECOMP_VSH_IO") != NULL;
+    if (io && n < 16u &&
+        (fabsf(out->pos[0]) > 4096.0f || fabsf(out->pos[1]) > 4096.0f ||
+         fabsf(out->pos[0]) > 4096.0f * fabsf(out->pos[3]))) {
+        n++;
+        fprintf(stderr, "  [VSH-IO] #%u v0=%.4g,%.4g,%.4g,%.4g v1=%.4g,%.4g,%.4g,%.4g"
+                        " v2=%.4g,%.4g,%.4g,%.4g -> pos %.5g,%.5g,%.5g,%.5g\n",
+                n,
+                in[0][0], in[0][1], in[0][2], in[0][3],
+                in[1][0], in[1][1], in[1][2], in[1][3],
+                in[2][0], in[2][1], in[2][2], in[2][3],
+                out->pos[0], out->pos[1], out->pos[2], out->pos[3]);
+        fflush(stderr);
+    }
+    return r;
+}
