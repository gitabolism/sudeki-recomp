--- a/src/kernel/nv2a_pb_exec.c
+++ b/src/kernel/nv2a_pb_exec.c
@@ -760,6 +760,26 @@
     *trap = 0x00000100u;                /* method = NO_OPERATION */
     *tdat = param;                      /* dispatcher's argument */
     *pmc |= 0x00001000u;                /* PMC: PGRAPH asserted */
+    /* Patch 0043 (note 0023, frz71): on hardware the trap asserts the
+     * NV2A PCI line the instant TRAP_DATA is written, so the guest's
+     * graphics ISR runs promptly, sees PMC, and queues the GPU DPC —
+     * which drains at the ISR's exit. frz71 measured the alternative:
+     * the mark sat armed until the next coincidental guest path
+     * noticed, service rate ~0.5/s, and with 0042's suspension the
+     * channel throttled to that rate (262 flips). Post the same line
+     * the vblank model uses (line 0 = the NV2A's PCI line). Coalesces
+     * like a latched line. RECOMP_SWMARK_IRQPOST=0 opts out. */
+    {
+        static int post = -1;
+        if (post < 0) {
+            const char *e = getenv("RECOMP_SWMARK_IRQPOST");
+            post = !(e && e[0] == '0');
+        }
+        if (post) {
+            extern int xbox_IrqPost(int);
+            xbox_IrqPost(0);
+        }
+    }
     s_last_param = param;
     InterlockedExchange(&s_sw_seen, 0);
     InterlockedExchange(&s_sw_latched, 1);
