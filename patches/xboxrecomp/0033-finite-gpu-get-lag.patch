+/* Patch 0033 (note 0023, H29): finite-GPU GET publication. The walk executes
+ * methods synchronously, so publishing GET==PUT makes the GPU infinitely
+ * fast; D3D8LTCG's ring writer (sub_002D57D0) computes free = (block+4) -
+ * GET and parks in an INFINITE KeWaitForSingleObject loop when GET has run
+ * PAST the block it is about to serve — which is permanent for us because
+ * our GET never lags (frz30 core: GET 48 KB past the queued block, free
+ * negative). Hardware keeps GET behind PUT at GPU speed, so the block queue
+ * always sits ahead of GET. Emulate the lag on the PUBLISHED register only:
+ * RECOMP_PB_GET_LAG=<bytes> publishes GET = consumption trail minus that
+ * many bytes; the walk's internal position is unchanged. A snapshot ring of
+ * visited positions gives the trail through JUMP/CALL segments. */
+
+
+static void pb_lag_init(void)
+{
+    static int done;
+    if (done)
+        return;
+    done = 1;
+    {
+        const char *e = getenv("RECOMP_PB_GET_LAG");
+        if (e && *e)
+            s_get_lag_bytes = (uint32_t)strtoul(e, 0, 0);
+    }
+}
+
+static void pb_lag_note(uint32_t pos)
+{
+    if (!s_get_lag_bytes)
+        return;
+    s_lag_seen++;
+    if ((s_lag_seen & (PB_LAG_STRIDE - 1u)) == 0) {
+        s_lag_hist[s_lag_head & (PB_LAG_HIST - 1u)] = pos;
+        s_lag_head++;
+    }
+}
+
+/* The trail position s_get_lag_bytes behind the just-consumed end. */
+static uint32_t pb_lag_pub(uint32_t got)
+{
+    uint32_t back;
+    if (!s_get_lag_bytes || s_lag_head == 0)
+        return got;
+    back = s_get_lag_bytes / (PB_LAG_STRIDE * 4u);
+    if (s_lag_head <= back + 1u)              /* history shorter than the lag */
+        return s_lag_hist[(s_lag_head - (s_lag_head < PB_LAG_HIST
+                                        ? s_lag_head : PB_LAG_HIST))
+                          & (PB_LAG_HIST - 1u)];
+    s_lag_dbg_got = got;
+    s_lag_dbg_pub = s_lag_hist[(s_lag_head - 1u - back) & (PB_LAG_HIST - 1u)];
+    return s_lag_dbg_pub;
+}
