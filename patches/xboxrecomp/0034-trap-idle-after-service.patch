+/* Patch 0034 (note 0023, H29): the PGRAPH trap quartet auto-idles once
+ * a mark has been serviced — the same coalescing rule patch 0025 uses
+ * at latch time ("trap register idle"). The ack path used to idle only
+ * PGRAPH_INTR + the PMC line, leaving PARAM/TRAP/TRAP_DATA in aperture
+ * RAM; the guest pump (sub_002DB250) dispatches on TRAP regardless of
+ * INTR, so an abandoned mark re-dispatched forever: frz35 measured
+ * 228k re-services of params 10500101/0DF80101 at the plateau, whose
+ * arm-0 ring bookkeeping is ADDITIVE (loc_002DB4C4: ctx+0x1C4 =
+ * edi+ebp each pass) — D3D's swap-completion indices drift, the
+ * branch that signals event 0x2E2F4C stops firing, the engine parks
+ * INFINITE (frz34 core), the load never completes. RECOMP_TRAP_IDLE=0
+ * opts out for A/B. */
+/* Census (0034 ext, note 0023): full attribution of the plateau storm —
+ * who latches/re-arms and who sees. rearm = done() with an unserviced
+ * mark (the word was set but no service read it); seen_l/seen_n =
+ * service-chain entries with / without a latch outstanding. */
+static volatile LONG s_trap_idle;
+
+static int pb_trap_idle_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_TRAP_IDLE");
+        on = !(e && e[0] == '0');
+    }
+    return on;
+}
+
+static void nv2a_pb_trap_idle(void)
+{
+    volatile uint32_t *prm  = xbox_Nv2aRegPtr(0x400108);
+    volatile uint32_t *trap = xbox_Nv2aRegPtr(0x400704);
+    volatile uint32_t *tdat = xbox_Nv2aRegPtr(0x400708);
+    if (prm)  *prm = 0;
+    if (trap) *trap = 0;
+    if (tdat) *tdat = 0;
+    InterlockedIncrement(&s_trap_idle);
+}
+
