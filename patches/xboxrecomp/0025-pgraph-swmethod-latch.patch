+         * (param & 0x1F). The ring-free class (low 5 bits == 5, the
+         * one whose guest arm signals 0x2E2F5C) is logged in full. */
+        LONG k = InterlockedIncrement(&s_nop_seen);
+        InterlockedIncrement(&s_nop_class[param & 0x1Fu]);
+        if ((param & 0x1Fu) == 5u || k <= 8)
+            fprintf(stderr, "  [NOPSW] #%ld subch=%u param=%08X class=%u\n",
+                    (long)k, subch, param, param & 0x1Fu);
+    }
     if (subch != 0) {                      /* 3D class lives on subchannel 0 */
         note_unhandled(method, param);
         return;
@@ -4531,8 +4705,14 @@
          * to D3D's interrupt handler on the console. Only the swap's interval
          * matters here (nv2a_flip_hold.h); the rest stays a no-op. */
         if (!nv2a_pb_exec_flip_pacing()) {
-            if (!imm_vertex_method(method, param))
