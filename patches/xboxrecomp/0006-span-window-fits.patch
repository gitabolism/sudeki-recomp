+#if !defined(_WIN32)
+#include <sys/mman.h>
+
+/* (sudeki-recomp local patch 0006 — note 0006.) Can a span placed at `base`
+ * host the whole guest window? The fixed windows (contiguous at guest
+ * 0x80000000, tiled 0xF0000000, NV2A 0xFD000000, MCPX 0xFE800000, flash
+ * 0xFF000000+1 MB) are all mapped at offset + guest VA, so if the topmost of
+ * them cannot be mapped, none of them can. Linux places mappings top-down: a
+ * span at the very top of the user address space puts those addresses outside
+ * the canonical range, mmap fails, and a title that touches a pinned physical
+ * buffer (Sudeki, guest 0x84000000) faults with nothing wrong in the guest. */
+static int span_hosts_window(const void *base)
+{
+#if defined(MAP_FIXED_NOREPLACE)
+    void *p = mmap((void *)((uintptr_t)base + 0xFF000000u), (size_t)1 << 20,
+                   PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE,
+                   -1, 0);
+    if (p == MAP_FAILED)
+        return 0;
+    munmap(p, (size_t)1 << 20);
+    return 1;
+#else
+    /* No MAP_FIXED_NOREPLACE (macOS): check the arithmetic instead, against
+     * the 48-bit user limit that host applies. */
+    return (uint64_t)(uintptr_t)base + ((uint64_t)1 << 32) <= ((uint64_t)1 << 47);
+#endif
+}
+#endif /* !_WIN32 */
 /* POSIX, RECOMP_EXT_VMA only: the span holds the whole 4 GB guest window, and
