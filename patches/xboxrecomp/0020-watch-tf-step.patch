+#if defined(__linux__) && defined(__x86_64__) && defined(REG_EFL)
+/* Patch 0020: the single-step leg of the POSIX watch trap (see handler).
+ * Fires on the thread that just re-executed its trapped store; re-protect
+ * the watched page and clear TF so the window closes one instruction after
+ * the store, not 200 us after it. */
+static void watch_posix_step_trap(int sig, siginfo_t *si, void *ucv)
+{
+    if (s_watch_stepping) {
+        ucontext_t *uc = (ucontext_t *)ucv;
+        s_watch_stepping = 0;
+        watch_posix_diff();
+        mprotect((void *)g_watch_hpage, g_watch_hsize, PROT_READ);
+        uc->uc_mcontext.gregs[REG_EFL] &= ~0x100u;
+        return;
+    }
+    if (g_watch_prev_trap.sa_flags & SA_SIGINFO) {
+        if (g_watch_prev_trap.sa_sigaction) {
+            g_watch_prev_trap.sa_sigaction(sig, si, ucv);
+            return;
+        }
+    } else if (g_watch_prev_trap.sa_handler != SIG_DFL
+            && g_watch_prev_trap.sa_handler != SIG_IGN) {
+        g_watch_prev_trap.sa_handler(sig);
+        return;
+    }
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
+#endif
