+/* Patch 0035 (note 0023, H29): consume a SERVICED mark at ack-pass rate.
+ * frz38 attribution: the guest's service chain entered with a mark
+ * latched 606,716 times while done() ran only 4,840 — dpc_run_here (the
+ * historical done() driver) drains far rarer than the DPC body runs, so
+ * each un-consumed pass re-dispatched the live TRAP_DATA (pump site
+ * 0x002DB2E9, runs of 90k+ in frz37/38): the arm-0 completion
+ * bookkeeping (loc_002DB4C4) is additive, drift froze the swap pump
+ * (4340 swaps in frz38 vs 1687 in frz37 — 0034's idle widened the
+ * margin), and drop=1741 shows the 64-deep pending queue overflowing.
+ * Same ownership rule as 0026 — hold until the chain has SEEN the mark
+ * — but the consume then happens on the ack tick (ms), not the next
+ * dpc_run_here (seconds). RECOMP_ACK_CONSUME=0 opts out (A/B). */
+int pb_consume_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_ACK_CONSUME");
+        on = !(e && e[0] == '0');
+    }
+    return on;
+}
+
+void nv2a_pb_swmethod_service_consume(void)
+{
+    if (pb_consume_on() && s_sw_latched && s_sw_seen)
+        nv2a_pb_swmethod_done();
+}
