+static CRITICAL_SECTION s_swm_cs;
+static INIT_ONCE s_swm_cs_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK swm_cs_init(PINIT_ONCE once, PVOID param, PVOID *ctx)
+{
+    (void)once; (void)param; (void)ctx;
+    InitializeCriticalSection(&s_swm_cs);
+    return TRUE;
+}
+
+static void swm_lock(void)
+{
+    InitOnceExecuteOnce(&s_swm_cs_once, swm_cs_init, NULL, NULL);
+    EnterCriticalSection(&s_swm_cs);
+}
+
+static void swm_unlock(void)
+{
+    LeaveCriticalSection(&s_swm_cs);
+}
