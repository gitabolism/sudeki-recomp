set confirm off
set pagination off
set architecture i386
set $n = 0
target remote 127.0.0.1:12353
break *0xAFBF0
commands
silent
set $n=$n+1
if ($n % 25) == 1
  printf "[AFBF0 x%d] ecx=%08X\n",$n,$ecx
end
continue
end
break *0xB14F0
commands
silent
printf "[B14F0] ecx=%08X\n",$ecx
continue
end
break *0x5BEB0
commands
silent
printf "[5BEB0 n=%d]\n",$n
continue
end
continue
