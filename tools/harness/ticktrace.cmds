set confirm off
set pagination off
set architecture i386
set $n = 0
set $m = 0
target remote 127.0.0.1:12353
break *0x5EC70
commands
silent
set $n=$n+1
if $n == 2
  printf "[RA 5EC70 #%d] ecx=%08X ra=%08X\n",$n,$ecx,*((unsigned int*)$esp)
  x/24xw $esp
  detach
  quit
end
continue
end
break *0x5EDB0
commands
silent
set $m=$m+1
if $m == 10
  printf "[RA 5EDB0 #%d] ecx=%08X ra=%08X\n",$m,$ecx,*((unsigned int*)$esp)
  x/24xw $esp
  detach
  quit
end
continue
end
continue
