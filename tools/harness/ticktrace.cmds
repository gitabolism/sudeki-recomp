set confirm off
set pagination off
set architecture i386
set $n = 0
set $m = 0
set $p = 0
target remote 127.0.0.1:12353
break *0x14960
commands
silent
set $n=$n+1
if $n == 1
  printf "[RA 14960 #1] ra=%08X\n",*((unsigned int*)$esp)
end
if $n == 400
  printf "[COUNT 14960] %d\n",$n
  detach
  quit
end
continue
end
break *0x137E20
commands
silent
set $m=$m+1
if ($m % 200) == 1
  printf "[137E20 x%d]\n",$m
end
if $m == 2000
  delete 2
end
continue
end
break *0x5BEB0
commands
silent
set $p=$p+1
if ($p % 100) == 1
  printf "[5BEB0 x%d]\n",$p
end
if $p == 800
  delete 3
end
continue
end
break *0xAFBF0
commands
silent
printf "[AFBF0]\n"
continue
end
continue
