set confirm off
set pagination off
set architecture i386
set $c = 0
target remote 127.0.0.1:12353
break *0x120A1
commands
silent
set $c=$c+1
if $c == 1
  printf "[120A1 #1] esp=%08X eax=%08X ebx=%08X edi=%08X\n",$esp,$eax,$ebx,$edi
  x/24xw $esp
end
if $c == 3
  detach
  quit
end
continue
end
continue
