set confirm off
set pagination off
handle SIGSEGV nostop noprint pass
handle SIGINT nostop noprint pass
handle SIGTERM nostop noprint pass
set $a=0
set $b=0
set $c=0
break sub_00011DE0
commands
silent
set $a=$a+1
printf "[11DE0 x%d]\n",$a
continue
end
break sub_000122C0
commands
silent
set $b=$b+1
if ($b % 200) == 1
  printf "[122C0 x%d]\n",$b
end
if $b == 2000
  detach
  quit
end
continue
end
break sub_000258420
commands
silent
set $c=$c+1
if ($c % 200) == 1
  printf "[258420 x%d]\n",$c
end
continue
end
