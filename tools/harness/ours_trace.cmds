set confirm off
set pagination off
handle SIGSEGV nostop noprint pass
handle SIGINT nostop noprint pass
handle SIGTERM nostop noprint pass
set $s = 0
tbreak sub_0026C92B
commands
silent
set $off = *(unsigned long long*)&g_xbox_mem_offset
watch *(unsigned int*)($off + 0x396F18)
condition 3 *(unsigned int*)($off + 0x396F18) != 0
continue
end
break sub_0026C79D
commands
silent
set $s=$s+1
if ($s % 200) == 1
  printf "[G396F18=%08X] sample %d\n",*(unsigned int*)(*(unsigned long long*)&g_xbox_mem_offset + 0x396F18),$s
end
continue
end
