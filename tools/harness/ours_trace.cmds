set confirm off
set pagination off
handle SIGSEGV nostop noprint pass
handle SIGINT nostop noprint pass
handle SIGTERM nostop noprint pass
break main
commands
silent
set $off = g_xbox_mem_offset
watch *(unsigned int*)($off + 0x27FE52C)
condition 2 *(unsigned int*)($off + 0x27FE52C) != 0
continue
end
break sub_000B14F0
commands
silent
printf "[B14F0]\n"
continue
end
break sub_000B17A3
commands
silent
printf "[B17A3]\n"
continue
end
