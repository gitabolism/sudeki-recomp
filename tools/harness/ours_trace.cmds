set confirm off
set pagination off
handle SIGSEGV nostop noprint pass
handle SIGINT nostop noprint pass
handle SIGTERM nostop noprint pass
set $n = 0
break sub_0005EC70
commands
silent
printf "[5EC70]\n"
bt 4
continue
end
break sub_0005EDB0
commands
silent
printf "[5EDB0]\n"
bt 4
continue
end
break sub_00070A20
commands
silent
printf "[70A20]\n"
bt 4
continue
end
break sub_0007EB20
commands
silent
printf "[7EB20]\n"
bt 3
continue
end
break sub_00058E30
commands
silent
printf "[58E30]\n"
bt 3
continue
end
break sub_00058810
commands
silent
printf "[58810 pumpobj-CTOR]\n"
bt 4
continue
end
break sub_00072A40
commands
silent
set $n=$n+1
if ($n % 100) == 1
  printf "[72A40 x%d] ecx=%08X\n",$n,$ecx
end
if $n == 2000
  delete 7
end
continue
end
