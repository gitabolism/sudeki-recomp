set confirm off
set pagination off
handle SIGSEGV nostop noprint pass
handle SIGINT nostop noprint pass
handle SIGTERM nostop noprint pass
set $n = 0
break sub_0005BEB0
commands
silent
set $n=$n+1
set $a = *(unsigned int*)($esp+0x3c)
set $a = $a & 0x7f
set $e = *(unsigned int*)($ecx+0x40+$a*4)
if ($n % 50) == 1
  printf "[5BEB0 x%d] ecx=%08X id=%02X entry=%08X\n",$n,$ecx,$a,$e
end
if ($e != 0 && ($n % 200) == 0)
  printf "[5BEB0 POP x%d] id=%02X entry=%08X\n",$n,$a,$e
end
if $n == 4000
  printf "[5BEB0 x4000 -> bp deleted]\n"
  delete 1
end
continue
end
break sub_0005EC70
commands
silent
printf "[5EC70] ecx=%08X\n",$ecx
bt 6
continue
end
break sub_0005EDB0
commands
silent
printf "[5EDB0] ecx=%08X\n",$ecx
bt 6
continue
end
