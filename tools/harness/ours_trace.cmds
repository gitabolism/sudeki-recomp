set confirm off
set pagination off
handle SIGSEGV nostop noprint pass
handle SIGINT nostop noprint pass
handle SIGTERM nostop noprint pass
set $a=0
set $b=0
set $c=0
break sub_0026D3E4
commands
silent
set $a=$a+1
printf "[26D3E4 x%d]\n",$a
continue
end
break sub_0026D1E6
commands
silent
set $b=$b+1
printf "[26D1E6 x%d]\n",$b
continue
end
break sub_0027241C
commands
silent
set $c=$c+1
printf "[27241C x%d]\n",$c
continue
end
