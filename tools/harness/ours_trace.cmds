set confirm off
set pagination off
handle SIGSEGV nostop noprint pass
handle SIGINT nostop noprint pass
handle SIGTERM nostop noprint pass
set $a=0
set $b=0
break sub_001A9A50
commands
silent
set $a=$a+1
if ($a % 2000) == 1
  printf "[1A9A50 x%d] edi=%08X\n",$a,$edi
end
if $a == 20000
  printf "[1A9A50 STOP 20000]\n"
  detach
  quit
end
continue
end
break sub_00027430
commands
silent
set $b=$b+1
if ($b % 500) == 1
  printf "[27430 x%d]\n",$b
end
continue
end
